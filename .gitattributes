# Auto-detect text files and normalize line endings
* text=auto eol=lf

# Python source
*.py text diff=python

# Jupyter notebooks
*.ipynb text diff=jupyter

# CSV data
*.csv text

# HTML
*.html text diff=html

# Markdown
*.md text

# YAML/TOML/JSON configs
*.yml text
*.yaml text
*.toml text
*.json text

# Security: prevent secret files from appearing in diffs if accidentally created
*.env -diff
*.env.* -diff
*.pem -diff
*.key -diff
*.cert -diff
*.crt -diff
*.p12 -diff
*.pfx -diff
*.pkcs12 -diff
*.kdbx -diff
*id_rsa* -diff
*id_ed25519* -diff
*credentials*.json -diff
*client_secret*.json -diff
*service-account*.json -diff
*token*.json -diff

# Shell / batch scripts
*.sh text eol=lf
*.bat text eol=crlf
*.ps1 text eol=crlf

# Requirements
requirements.txt text
requirements*.txt text

# Binary files - don't modify
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.zip binary
*.npy binary
*.pkl binary
*.pickle binary
*.joblib binary
*.db binary
*.sqlite binary
*.sqlite3 binary

# Archive export ignores: exclude development, CI, and test tooling from release archives
.github/ export-ignore
.gitleaks.toml export-ignore
.pre-commit-config.yaml export-ignore
.gitattributes export-ignore
.gitignore export-ignore
.git-blame-ignore-revs export-ignore
.gitmessage export-ignore
tests/ export-ignore
